{
    "name": "domenig/notariat-schuldbrief",
    "description": "Online-Antrag Schuldbriefbestellung – Domenig & Partner Notariat AG",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Schuldbrief\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schuldbrief\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
