# Vorlage: kopieren nach .env und Werte setzen. .env NIE ins Git.

# Betriebsart: mock (nichts wird gesendet) | test (alle Mails ans Testpostfach) | live
APP_MODE=mock

# Zufälliger Schlüssel, mindestens 32 Zeichen. Erzeugen mit:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# In test und live Pflicht, in mock optional.
APP_SECRET=

# Ausweiskopien (Upload): höchste Grösse pro Datei in MB und höchste Anzahl Dateien.
# Erlaubt sind JPG, PNG und PDF. PHP-Grenzen (upload_max_filesize, post_max_size) müssen höher sein.
UPLOAD_MAX_MB=5
UPLOAD_MAX_FILES=6

# Kontakt und Links
CONTACT_PHONE=+41 58 531 20 00
CONTACT_EMAIL=notariat@domenig.law
OFFICE_ADDRESS=Laupenstrasse 1, 3008 Bern
PRIVACY_URL_DE=https://www.domenig.law/datenschutz
# FR/EN: vorerst die deutsche Fassung (Atoll verlangt für jeden Schlüssel einen Wert)
PRIVACY_URL_FR=https://www.domenig.law/datenschutz
PRIVACY_URL_EN=https://www.domenig.law/datenschutz

# Microsoft Graph (nur für APP_MODE=test und live)
# Entra-ID-App «Schuldbriefbestellung (Atoll)», nur Mail.Send (Einrichtung durch InfoPro).
# IDs sind nicht geheim, der Schlüssel schon: GRAPH_CLIENT_SECRET nur direkt in Atoll bzw. in der
# .env auf dem Server eintragen (Quelle: LastPass).
GRAPH_TENANT_ID=ae4b51b9-1564-4bd2-a852-6100861922ec
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Testpostfach: im Modus test Absender UND Empfänger aller Mails (auch der Bestätigung an die Bank)
TEST_MAILBOX=test-notariat@domenig.law
GRAPH_TIMEOUT_SECONDS=10

# Mails
# Absender aller Mails (interne Mail und Bestätigung an die Bank)
SENDER_MAILBOX=notariat@domenig.law
# Wer bei jedem Antrag eine Mail erhält – jede Adresse ein eigenes Exemplar
INTERNAL_RECIPIENTS=info@domenig.law,notariat@domenig.law,schneider@domenig.law
# Wer davon die Ausweiskopien als Anhang erhält (muss in INTERNAL_RECIPIENTS stehen)
ID_COPY_RECIPIENTS=info@domenig.law,notariat@domenig.law,schneider@domenig.law
