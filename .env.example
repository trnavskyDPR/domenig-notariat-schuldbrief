# Vorlage: kopieren nach .env und Werte setzen. .env NIE ins Git.

# Betriebsart: mock (nichts wird gesendet) | test (alle Mails ans Testpostfach) | live
APP_MODE=mock

# Zufälliger Schlüssel, mindestens 32 Zeichen. Erzeugen mit:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# In test und live Pflicht, in mock optional.
APP_SECRET=

# Ausweiskopien (Upload): höchste Grösse pro Datei in MB und höchste Anzahl Dateien.
# Erlaubt sind JPG, PNG und PDF. PHP-Grenzen (upload_max_filesize, post_max_size) müssen höher sein.
UPLOAD_MAX_MB=5
UPLOAD_MAX_FILES=6

# Kontakt und Links
CONTACT_PHONE=+41 58 531 20 00
CONTACT_EMAIL=notariat@domenig.law
OFFICE_ADDRESS=Laupenstrasse 1, 3008 Bern
PRIVACY_URL_DE=https://www.domenig.law/datenschutz
# FR/EN: vorerst die deutsche Fassung (Atoll verlangt für jeden Schlüssel einen Wert)
PRIVACY_URL_FR=https://www.domenig.law/datenschutz
PRIVACY_URL_EN=https://www.domenig.law/datenschutz
